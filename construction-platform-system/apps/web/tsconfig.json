{
  "extends": "@ci/config/tsconfig.base",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "node",
      "react"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ci/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@ci/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@ci/db": [
        "../../packages/db/src/index.ts"
      ],
      "@ci/db/*": [
        "../../packages/db/src/*"
      ],
      "@ci/ui": [
        "../../packages/ui/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
