# Construction Intelligence — env contract (§4.3). Copy to .env and fill in.
# Guardrail #10: NO secrets in source. .env is gitignored; never commit real values.
# Validated at boot by apps/web/src/lib/env.ts (Zod) and services/ai/app/settings.py (Pydantic).

# --- Data (MariaDB / XAMPP) ---
# Owner connection (root) — runs migrations + Better Auth. XAMPP default root has NO
# password. If you set one, use mysql://root:<pwd>@localhost:3306/...
DATABASE_URL=mysql://root@localhost:3306/construction_intelligence
# The app connects as the least-privilege `ci_app` user (DML only, no DDL). NOTE:
# MariaDB has no Row-Level Security — tenant isolation is enforced app-side by the
# scoped repository, not the DB (see packages/db/src/scoped.ts).
APP_DATABASE_URL=mysql://ci_app:ci_app_local_dev@localhost:3306/construction_intelligence
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local <-> Cloudflare R2 prod; config-only swap) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ci_minio
S3_SECRET_KEY=ci_minio_local
S3_BUCKET=ci-dev

# --- Auth (generate locally; never commit) ---
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000

# --- AI providers (from the secrets manager) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Observability (Langfuse — added in ws 0.8) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Cross-runtime ---
# The AI tier's FastAPI port; the noop_probe seam round-trips TS -> Redis -> Python -> TS.
AI_SERVICE_URL=http://localhost:8000
