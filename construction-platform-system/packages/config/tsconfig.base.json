{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "paths": {
      "@ci/shared": ["../shared/src/index.ts"],
      "@ci/shared/*": ["../shared/src/*"],
      "@ci/db": ["../db/src/index.ts"],
      "@ci/db/*": ["../db/src/*"],
      "@ci/ui": ["../ui/src/index.ts"],
      "@ci/ui/*": ["../ui/src/*"]
    }
  }
}
