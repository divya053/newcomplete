# ---- Dependencies ----
node_modules/
.pnpm-store/
.venv/
venv/
__pycache__/
*.py[cod]

# ---- Build output ----
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# ---- Caches ----
.cache/
.pytest_cache/
.mypy_cache/
.eslintcache

# ---- Secrets (keep the .example files) ----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
id_rsa*

# ---- Runtime data / user uploads (not source) ----
uploads/
.uploads/
.pgdata/
*.sqlite
*.sqlite3

# ---- Archives ----
*.zip
*.tgz
*.tar.gz

# ---- Logs ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# ---- Local agent config ----
.claude/settings.local.json

# ---- Disabled nested repo histories (kept locally, not published) ----
.git.disabled/

# ---- Autosync runtime log (the script itself IS versioned) ----
.autosync/sync.log

# ---- git subtree split scratch ----
# `git subtree split` - how the techsmeinc mirrors are published - leaves this
# in the repo root. It is git's own filter-branch scratch space: refs, an index
# and a commit map. Autosync committed all 29 files of it before anyone noticed.
.git-rewrite/
